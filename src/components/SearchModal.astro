---
/**
 * Pagefind search modal — triggered by ⌘K (macOS) or Ctrl+K (others).
 *
 * Pagefind generates its own JS/CSS bundle at /pagefind/ during `npm run build`
 * (specifically the `pagefind --site dist` step after `astro build`).
 *
 * `pagefind-ui.js` is a UMD bundle that attaches `PagefindUI` to `window` — it
 * is NOT an ES module, so we load it through a classic script element.
 * Dynamic import of the UI bundle will fail with a "not a module" error.
 *
 * In dev mode the index doesn't exist yet; we show a graceful empty state.
 */
---

<div
  id="search-modal"
  class="search-overlay fixed inset-0 z-50 hidden items-start justify-center px-4"
  style="background: rgba(10, 14, 26, 0.85); backdrop-filter: blur(4px);"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Search"
>
  <div
    class="search-panel w-full max-w-2xl overflow-hidden"
  >
    <div id="pagefind-search-container"></div>
  </div>
</div>

<script>
  // --- Pagefind UI loader (script-tag based) ---
  //
  // pagefind-ui.js is a UMD bundle, not an ES module. We load it by injecting
  // script and stylesheet elements and waiting for window.PagefindUI.

  const modal = document.getElementById('search-modal');
  const trigger = document.getElementById('search-trigger');
  const container = document.getElementById('pagefind-search-container');

  let pagefindUILoading: Promise<boolean> | null = null;

  function loadScript(src: string): Promise<void> {
    return new Promise((resolve, reject) => {
      // Avoid double-load
      if (document.querySelector(`script[data-pagefind-ui]`)) {
        resolve();
        return;
      }
      const script = document.createElement('script');
      script.src = src;
      script.dataset.pagefindUi = 'true';
      script.onload = () => resolve();
      script.onerror = () => reject(new Error(`Failed to load ${src}`));
      document.head.appendChild(script);
    });
  }

  function loadStylesheet(href: string): Promise<void> {
    return new Promise((resolve, reject) => {
      if (document.querySelector(`link[data-pagefind-ui]`)) {
        resolve();
        return;
      }
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = href;
      link.dataset.pagefindUi = 'true';
      link.onload = () => resolve();
      link.onerror = () => reject(new Error(`Failed to load ${href}`));
      document.head.appendChild(link);
    });
  }

  async function loadPagefindUI(): Promise<boolean> {
    if (pagefindUILoading) return pagefindUILoading;

    pagefindUILoading = (async () => {
      // Pagefind output lives at <base>/pagefind/* — derive from current pathname's leading segment.
      // import.meta.env.BASE_URL is inlined at build time and matches Astro's `base` config.
      const baseUrl = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
      const origin = window.location.origin;
      const uiJs = `${origin}${baseUrl}/pagefind/pagefind-ui.js`;
      const uiCss = `${origin}${baseUrl}/pagefind/pagefind-ui.css`;

      try {
        // Check index exists first — gives a cleaner error in dev mode
        const probe = await fetch(`${origin}${baseUrl}/pagefind/pagefind.js`, { method: 'HEAD' });
        if (!probe.ok) throw new Error('pagefind index missing');

        await Promise.all([loadStylesheet(uiCss), loadScript(uiJs)]);

        // @ts-expect-error — PagefindUI is a global set by the loaded script
        if (typeof window.PagefindUI !== 'function') {
          throw new Error('PagefindUI constructor not found on window');
        }

        // @ts-expect-error — same global reference
        new window.PagefindUI({
          element: '#pagefind-search-container',
          showSubResults: true,
          showImages: false,
          resetStyles: false,
          translations: {
            placeholder: '딥다이브 검색... (제목, 본문, 태그)',
            clear_search: '초기화',
            load_more: '더 불러오기',
            search_label: '검색',
            filters_label: '필터',
            zero_results: '"[SEARCH_TERM]"에 대한 결과가 없습니다',
            many_results: '"[SEARCH_TERM]"에 대한 결과 [COUNT]개',
            one_result: '"[SEARCH_TERM]"에 대한 결과 1개',
            alt_search: '"[SEARCH_TERM]"에 대한 결과 없음 · "[DIFFERENT_TERM]"으로 검색',
            search_suggestion: '다음 검색어를 시도하세요: [DIFFERENT_TERM]',
            searching: '"[SEARCH_TERM]" 검색 중...',
          },
        });

        return true;
      } catch (err) {
        console.warn('[search] Pagefind UI load failed:', err);
        if (container) {
          container.innerHTML =
            '<div style="padding: 2rem; text-align: center; color: var(--color-text-tertiary); font-family: var(--font-mono); font-size: 12px;">// 검색 인덱스를 불러올 수 없습니다. 빌드 후 다시 시도하세요.</div>';
        }
        return false;
      }
    })();

    return pagefindUILoading;
  }

  function openModal() {
    if (!modal) return;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    modal.setAttribute('aria-hidden', 'false');
    trigger?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';

    loadPagefindUI().then((ok) => {
      if (!ok) return;
      // Focus the search input once PagefindUI has rendered it
      requestAnimationFrame(() => {
        const input = modal.querySelector<HTMLInputElement>('.pagefind-ui__search-input');
        input?.focus();
      });
    });
  }

  function closeModal() {
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    modal.setAttribute('aria-hidden', 'true');
    trigger?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    trigger?.focus();
  }

  trigger?.addEventListener('click', openModal);

  document.addEventListener('keydown', (e) => {
    const mod = e.metaKey || e.ctrlKey;
    if (mod && e.key === 'k') {
      e.preventDefault();
      if (modal?.classList.contains('hidden')) openModal();
      else closeModal();
    }
    if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
      closeModal();
    }
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
</script>

<style>
  .search-overlay {
    padding-top: clamp(1rem, 10dvh, 6rem);
  }

  .search-panel {
    background: rgba(13, 18, 32, 0.96);
    border: 1px solid var(--color-border-strong);
    border-radius: 14px;
    box-shadow:
      0 24px 70px rgba(0, 0, 0, 0.42),
      0 0 0 1px rgba(0, 217, 255, 0.025);
  }

  @media (max-width: 640px) {
    .search-overlay {
      padding-top: clamp(1rem, 8dvh, 3.5rem);
      padding-right: 0.75rem;
      padding-left: 0.75rem;
    }
  }
</style>

<style is:global>
  /* Scope tokens to the widget so Pagefind's late-loaded :root defaults cannot win. */
  #pagefind-search-container {
    --search-field-height: 60px;
    --search-icon-size: 20px;
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: var(--color-accent-cyan);
    --pagefind-ui-text: var(--color-text-primary);
    --pagefind-ui-background: var(--color-surface);
    --pagefind-ui-border: var(--color-border-strong);
    --pagefind-ui-tag: var(--color-elevated);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 8px;
    --pagefind-ui-image-border-radius: 6px;
    --pagefind-ui-image-box-ratio: 3 / 2;
    --pagefind-ui-font: var(--font-sans);
    padding: 0.875rem;
  }

  /* One shared coordinate system keeps the field, icon, and clear control centered. */
  .pagefind-ui__form {
    position: relative !important;
    border: none !important;
    padding: 0 !important;
  }
  .pagefind-ui__form::before {
    width: var(--search-icon-size) !important;
    height: var(--search-icon-size) !important;
    top: calc((var(--search-field-height) - var(--search-icon-size)) / 2) !important;
    left: 1.125rem !important;
    background-color: var(--color-text-secondary) !important;
    opacity: 0.9 !important;
    -webkit-mask-size: 100% 100% !important;
    mask-size: 100% 100% !important;
  }
  .pagefind-ui__search-input {
    width: 100% !important;
    height: var(--search-field-height) !important;
    box-sizing: border-box !important;
    padding: 0 6.5rem 0 3.25rem !important;
    background: var(--color-surface) !important;
    color: var(--color-text-primary) !important;
    border: 1px solid var(--color-border-subtle) !important;
    border-radius: 10px !important;
    font-family: var(--font-sans) !important;
    font-size: 1rem !important;
    font-weight: 550 !important;
    line-height: 1.2 !important;
    appearance: none !important;
    -webkit-appearance: none !important;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease !important;
  }
  .pagefind-ui__search-input::placeholder {
    color: var(--color-text-tertiary) !important;
    opacity: 0.72 !important;
    font-weight: 450 !important;
  }
  .pagefind-ui__search-input:focus {
    border-color: var(--color-accent-cyan) !important;
    outline: none !important;
    box-shadow:
      0 0 0 3px var(--color-accent-cyan-dim),
      inset 0 0 0 1px rgba(0, 217, 255, 0.08) !important;
  }
  .pagefind-ui__search-clear {
    position: absolute !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    top: calc((var(--search-field-height) - 34px) / 2) !important;
    right: 0.75rem !important;
    height: 34px !important;
    margin: 0 !important;
    padding: 0 0.7rem !important;
    appearance: none !important;
    -webkit-appearance: none !important;
    background: var(--color-elevated) !important;
    border: 1px solid var(--color-border-subtle) !important;
    border-radius: 8px !important;
    color: var(--color-text-secondary) !important;
    font-family: var(--font-sans) !important;
    font-size: 0.75rem !important;
    font-weight: 600 !important;
    line-height: 1 !important;
    box-shadow: none !important;
    transform: none !important;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background-color 0.15s ease !important;
  }
  .pagefind-ui__search-clear:hover {
    background: var(--color-accent-cyan-dim) !important;
    border-color: var(--color-accent-cyan-line) !important;
    color: var(--color-accent-cyan) !important;
  }
  .pagefind-ui__search-clear:focus-visible {
    outline: 2px solid var(--color-accent-cyan) !important;
    outline-offset: 2px !important;
  }
  .pagefind-ui__drawer {
    max-height: min(60vh, calc(100dvh - 12rem));
    overflow-y: auto;
    padding: 0 !important;
  }
  .pagefind-ui__results-area {
    margin-top: 0.875rem !important;
  }
  .pagefind-ui__result {
    border-bottom: 1px solid var(--color-border-subtle) !important;
    padding: 0.75rem 0 !important;
  }
  .pagefind-ui__result:last-child {
    border-bottom: none !important;
  }
  .pagefind-ui__result-title {
    font-size: 1rem !important;
    margin-bottom: 0.25rem !important;
  }
  .pagefind-ui__result-title a {
    color: var(--color-text-primary) !important;
    text-decoration: none !important;
  }
  .pagefind-ui__result-title a:hover {
    color: var(--color-accent-cyan) !important;
  }
  .pagefind-ui__result-excerpt {
    color: var(--color-text-secondary) !important;
    font-size: 0.875rem !important;
    line-height: 1.5 !important;
  }
  .pagefind-ui__result-excerpt mark {
    background: rgba(0, 217, 255, 0.15) !important;
    color: var(--color-accent-cyan) !important;
    padding: 0 2px;
    border-radius: 2px;
  }
  .pagefind-ui__button {
    background: var(--color-elevated) !important;
    color: var(--color-text-primary) !important;
    border: 1px solid var(--color-border-subtle) !important;
  }
  .pagefind-ui__message {
    color: var(--color-text-secondary) !important;
    height: auto !important;
    min-height: 2rem;
    padding: 0.375rem 0 0.75rem !important;
  }

  @media (max-width: 640px) {
    #pagefind-search-container {
      --search-field-height: 56px;
      --search-icon-size: 18px;
      padding: 0.75rem;
    }

    .pagefind-ui__form::before {
      left: 1rem !important;
    }

    .pagefind-ui__search-input {
      padding-right: 5.75rem !important;
      padding-left: 2.875rem !important;
      font-size: 1rem !important;
    }

    .pagefind-ui__search-clear {
      top: calc((var(--search-field-height) - 32px) / 2) !important;
      right: 0.625rem !important;
      height: 32px !important;
      padding: 0 0.6rem !important;
      font-size: 0.7rem !important;
    }

    .pagefind-ui__drawer {
      max-height: calc(100dvh - 10rem);
    }
  }
</style>
