---
/**
 * Pagefind search modal — triggered by ⌘K (macOS) or Ctrl+K (others).
 *
 * Pagefind generates its own JS/CSS bundle at /pagefind/ during `npm run build`
 * (specifically the `pagefind --site dist` step after `astro build`).
 *
 * `pagefind-ui.js` is a UMD bundle that attaches `PagefindUI` to `window` — it
 * is NOT an ES module, so we must load it via <script> tag. Dynamic import()
 * of the UI bundle will fail with a "not a module" error.
 *
 * In dev mode the index doesn't exist yet; we show a graceful empty state.
 */
---

<div
  id="search-modal"
  class="fixed inset-0 z-50 hidden items-start justify-center pt-[15vh] px-4"
  style="background: rgba(10, 14, 26, 0.85); backdrop-filter: blur(4px);"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Search"
>
  <div
    class="w-full max-w-2xl rounded-lg overflow-hidden"
    style="background: var(--color-surface); border: 1px solid var(--color-border-strong);"
  >
    <div id="pagefind-search-container"></div>
  </div>
</div>

<script>
  // --- Pagefind UI loader (script-tag based) ---
  //
  // pagefind-ui.js is a UMD bundle, not an ES module. We load it by injecting
  // <script> and <link> tags and waiting for window.PagefindUI to be defined.

  const modal = document.getElementById('search-modal');
  const trigger = document.getElementById('search-trigger');
  const container = document.getElementById('pagefind-search-container');

  let pagefindUILoading: Promise<boolean> | null = null;

  function loadScript(src: string): Promise<void> {
    return new Promise((resolve, reject) => {
      // Avoid double-load
      if (document.querySelector(`script[data-pagefind-ui]`)) {
        resolve();
        return;
      }
      const script = document.createElement('script');
      script.src = src;
      script.dataset.pagefindUi = 'true';
      script.onload = () => resolve();
      script.onerror = () => reject(new Error(`Failed to load ${src}`));
      document.head.appendChild(script);
    });
  }

  function loadStylesheet(href: string): void {
    if (document.querySelector(`link[data-pagefind-ui]`)) return;
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = href;
    link.dataset.pagefindUi = 'true';
    document.head.appendChild(link);
  }

  async function loadPagefindUI(): Promise<boolean> {
    if (pagefindUILoading) return pagefindUILoading;

    pagefindUILoading = (async () => {
      const base = window.location.origin;
      const uiJs = `${base}/pagefind/pagefind-ui.js`;
      const uiCss = `${base}/pagefind/pagefind-ui.css`;

      try {
        // Check index exists first — gives a cleaner error in dev mode
        const probe = await fetch(`${base}/pagefind/pagefind.js`, { method: 'HEAD' });
        if (!probe.ok) throw new Error('pagefind index missing');

        loadStylesheet(uiCss);
        await loadScript(uiJs);

        // @ts-expect-error — PagefindUI is a global set by the loaded script
        if (typeof window.PagefindUI !== 'function') {
          throw new Error('PagefindUI constructor not found on window');
        }

        // @ts-expect-error — same global reference
        new window.PagefindUI({
          element: '#pagefind-search-container',
          showSubResults: true,
          showImages: false,
          resetStyles: false,
          translations: {
            placeholder: '딥다이브 검색... (제목, 본문, 태그)',
            clear_search: '초기화',
            load_more: '더 불러오기',
            search_label: '검색',
            filters_label: '필터',
            zero_results: '"[SEARCH_TERM]"에 대한 결과가 없습니다',
            many_results: '"[SEARCH_TERM]"에 대한 결과 [COUNT]개',
            one_result: '"[SEARCH_TERM]"에 대한 결과 1개',
            alt_search: '"[SEARCH_TERM]"에 대한 결과 없음 · "[DIFFERENT_TERM]"으로 검색',
            search_suggestion: '다음 검색어를 시도하세요: [DIFFERENT_TERM]',
            searching: '"[SEARCH_TERM]" 검색 중...',
          },
        });

        return true;
      } catch (err) {
        console.warn('[search] Pagefind UI load failed:', err);
        if (container) {
          container.innerHTML =
            '<div style="padding: 2rem; text-align: center; color: var(--color-text-tertiary); font-family: var(--font-mono); font-size: 12px;">// 검색 인덱스를 불러올 수 없습니다. 빌드 후 다시 시도하세요.</div>';
        }
        return false;
      }
    })();

    return pagefindUILoading;
  }

  function openModal() {
    if (!modal) return;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';

    loadPagefindUI().then((ok) => {
      if (!ok) return;
      // Focus the search input once PagefindUI has rendered it
      requestAnimationFrame(() => {
        const input = modal.querySelector<HTMLInputElement>('.pagefind-ui__search-input');
        input?.focus();
      });
    });
  }

  function closeModal() {
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  trigger?.addEventListener('click', openModal);

  document.addEventListener('keydown', (e) => {
    const mod = e.metaKey || e.ctrlKey;
    if (mod && e.key === 'k') {
      e.preventDefault();
      if (modal?.classList.contains('hidden')) openModal();
      else closeModal();
    }
    if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
      closeModal();
    }
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
</script>

<style is:global>
  /* Pagefind UI theming — tokens override Pagefind's defaults */
  :root {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: var(--color-accent-cyan);
    --pagefind-ui-text: var(--color-text-primary);
    --pagefind-ui-background: var(--color-surface);
    --pagefind-ui-border: var(--color-border-strong);
    --pagefind-ui-tag: var(--color-elevated);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 8px;
    --pagefind-ui-image-border-radius: 6px;
    --pagefind-ui-image-box-ratio: 3 / 2;
    --pagefind-ui-font: var(--font-sans);
  }

  /* Remove Pagefind's own box since we're rendering inside our modal frame */
  .pagefind-ui__form {
    border: none !important;
    padding: 0.75rem 0.75rem 0 !important;
  }
  .pagefind-ui__search-input {
    background: var(--color-surface) !important;
    color: var(--color-text-primary) !important;
    border: 1px solid var(--color-border-subtle) !important;
  }
  .pagefind-ui__search-input:focus {
    border-color: var(--color-accent-cyan) !important;
    outline: none !important;
  }
  .pagefind-ui__drawer {
    max-height: 60vh;
    overflow-y: auto;
    padding: 0 0.75rem 0.75rem !important;
  }
  .pagefind-ui__result {
    border-bottom: 1px solid var(--color-border-subtle) !important;
    padding: 0.75rem 0 !important;
  }
  .pagefind-ui__result:last-child {
    border-bottom: none !important;
  }
  .pagefind-ui__result-title {
    font-size: 1rem !important;
    margin-bottom: 0.25rem !important;
  }
  .pagefind-ui__result-title a {
    color: var(--color-text-primary) !important;
    text-decoration: none !important;
  }
  .pagefind-ui__result-title a:hover {
    color: var(--color-accent-cyan) !important;
  }
  .pagefind-ui__result-excerpt {
    color: var(--color-text-secondary) !important;
    font-size: 0.875rem !important;
    line-height: 1.5 !important;
  }
  .pagefind-ui__result-excerpt mark {
    background: rgba(0, 217, 255, 0.15) !important;
    color: var(--color-accent-cyan) !important;
    padding: 0 2px;
    border-radius: 2px;
  }
  .pagefind-ui__button {
    background: var(--color-elevated) !important;
    color: var(--color-text-primary) !important;
    border: 1px solid var(--color-border-subtle) !important;
  }
  .pagefind-ui__message {
    color: var(--color-text-secondary) !important;
    padding: 0.5rem 0 !important;
  }
</style>
