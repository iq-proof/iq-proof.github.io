---
import { SITE, NAV } from '@/consts';
import { withBase, isActivePath } from '@/lib/url';
import TopologicalLogo from '@/components/TopologicalLogo.astro';
const currentPath = Astro.url.pathname;
---

<header
  class="iq-header sticky top-0 z-40 backdrop-blur-md"
  style="background: rgba(10, 14, 26, 0.72); height: var(--iq-header-height);"
>
  <div class="iq-header-inner">
    <!-- Logo — flush left, bigger, animated topology -->
    <a href={withBase('/')} class="iq-logo" aria-label={SITE.name}>
      <TopologicalLogo size={36} />
      <span class="iq-logo-text">{SITE.name}</span>
    </a>

    <!-- Nav — distributed across center, bigger items -->
    <nav class="iq-nav" aria-label="Primary">
      {
        NAV.map(({ href, label }) => {
          const active = isActivePath(currentPath, href);
          let activeColor = 'var(--color-accent-cyan)';
          if (href === '/categories/ai') activeColor = 'var(--color-accent-violet)';
          else if (href === '/categories/agent') activeColor = 'var(--color-accent-coral)';

          return (
              <a
                  href={withBase(href)}
                  class="iq-nav-link"
                  style={`color: ${active ? activeColor : 'var(--color-text-secondary)'};`}
                  aria-current={active ? 'page' : undefined}
              >
                {label}
              </a>
          );
        })
      }
    </nav>

    <!-- Search trigger — flush right, bigger -->
    <button id="search-trigger" type="button" class="iq-search" aria-label="Search">
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="8" />
        <path d="m21 21-4.35-4.35" />
      </svg>
      <span class="iq-search-label">Search</span>
      <kbd class="iq-search-kbd">⌘K</kbd>
    </button>
  </div>
</header>

<style>
  .iq-header {
    /* No bottom border — fluid handoff to hero */
    border-bottom: none;
  }

  .iq-header-inner {
    display: flex;
    align-items: center;
    height: 100%;
    /* Wider edge-aligned padding for "spread" feel */
    padding: 0 1.25rem 0 1.5rem;
    /* Allow content to span full width — no max-width constraint */
    max-width: 100%;
    gap: 1rem;
  }

  /* Logo — flush left, bigger */
  .iq-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }
  .iq-logo-text {
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }

  /* Nav — flex-1 to consume center space + space-around for distribution */
  .iq-nav {
    flex: 1;
    display: none;
    align-items: center;
    justify-content: center;
    gap: clamp(1.25rem, 3.2vw, 2.75rem);
  }
  @media (min-width: 768px) {
    .iq-nav {
      display: flex;
    }
  }

  .iq-nav-link {
    font-size: 0.95rem;
    font-weight: 500;
    transition: color 0.18s;
    white-space: nowrap;
  }
  .iq-nav-link:hover {
    color: var(--color-text-primary);
  }

  /* Search — flush right, bigger */
  .iq-search {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.55rem 0.875rem;
    border-radius: 0.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border-subtle);
    color: var(--color-text-tertiary);
    transition:
      color 0.15s,
      border-color 0.15s,
      background 0.15s;
    flex-shrink: 0;
    margin-left: auto;
  }
  .iq-search:hover {
    color: var(--color-text-primary);
    border-color: var(--color-accent-cyan-line);
  }
  .iq-search-label {
    font-size: 0.85rem;
    display: none;
  }
  .iq-search-kbd {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.7rem;
    padding: 1px 6px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--color-border-subtle);
    color: var(--color-text-tertiary);
    display: none;
  }
  @media (min-width: 640px) {
    .iq-search-label,
    .iq-search-kbd {
      display: inline;
    }
  }
</style>
