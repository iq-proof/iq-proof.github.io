---
import { SITE, NAV } from '@/consts';
import { withBase, isActivePath } from '@/lib/url';
import TopologicalLogo from '@/components/TopologicalLogo.astro';
const currentPath = Astro.url.pathname;
---

<header
  class="iq-header sticky top-0 z-40"
>
  <div class="iq-header-inner">
    <a href={withBase('/')} class="iq-logo" aria-label={SITE.name}>
      <TopologicalLogo size={40} />
      <span class="iq-logo-text">{SITE.name}</span>
    </a>

    <nav class="iq-nav" aria-label="Primary">
      {
        NAV.map(({ href, label }) => {
          const active = isActivePath(currentPath, href);
          let activeColor = 'var(--color-accent-cyan)';
          if (href === '/categories/ai') activeColor = 'var(--color-accent-violet)';
          else if (href === '/categories/agent') activeColor = 'var(--color-accent-coral)';

          return (
              <a
                  href={withBase(href)}
                  class="iq-nav-link"
                  style={`--nav-accent: ${activeColor};`}
                  aria-current={active ? 'page' : undefined}
              >
                {label}
              </a>
          );
        })
      }
    </nav>

    <button id="search-trigger" type="button" class="iq-search" aria-label="Search">
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="8" />
        <path d="m21 21-4.35-4.35" />
      </svg>
      <span class="iq-search-label">Search</span>
      <kbd class="iq-search-kbd">⌘K</kbd>
    </button>
  </div>
</header>

<style>
  .iq-header {
    height: var(--iq-header-height);
    background: rgba(10, 14, 26, 0.84);
    border-bottom: 1px solid rgba(148, 163, 184, 0.1);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.16);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .iq-header-inner {
    display: flex;
    align-items: center;
    height: 100%;
    padding: 0 0.75rem 0 4.5rem;
    gap: 0.75rem;
  }

  .iq-logo {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-shrink: 0;
    min-height: 44px;
    border-radius: 10px;
  }

  .iq-logo-text {
    font-size: 1.125rem;
    font-weight: 650;
    letter-spacing: -0.025em;
    color: var(--color-text-primary);
  }

  .iq-nav {
    display: none;
    align-items: center;
    justify-content: center;
  }

  .iq-nav-link {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.625rem;
    border-radius: 9px;
    color: var(--color-text-secondary);
    font-size: 1rem;
    font-weight: 550;
    line-height: 1;
    white-space: nowrap;
    transition:
      color 0.18s ease,
      background-color 0.18s ease;
  }

  .iq-nav-link::after {
    content: '';
    position: absolute;
    right: 28%;
    bottom: 3px;
    left: 28%;
    height: 2px;
    border-radius: 999px;
    background: currentColor;
    opacity: 0;
    transform: scaleX(0.55);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
  }

  .iq-nav-link:hover {
    color: var(--color-text-primary);
    background: rgba(255, 255, 255, 0.035);
  }

  .iq-nav-link[aria-current='page'] {
    color: var(--nav-accent);
    font-weight: 650;
  }

  .iq-nav-link[aria-current='page']::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .iq-search {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    width: 44px;
    height: 44px;
    padding: 0;
    border-radius: 10px;
    background: rgba(13, 18, 32, 0.78);
    border: 1px solid var(--color-border-subtle);
    color: var(--color-text-tertiary);
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background-color 0.15s ease,
      box-shadow 0.15s ease;
    flex-shrink: 0;
    margin-left: auto;
  }

  .iq-search:hover {
    color: var(--color-text-primary);
    border-color: var(--color-accent-cyan-line);
    background: var(--color-surface);
    box-shadow: 0 0 0 3px var(--color-accent-cyan-dim);
  }

  .iq-search-label {
    font-size: 0.9rem;
    font-weight: 500;
    display: none;
  }

  .iq-search-kbd {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.68rem;
    padding: 2px 6px;
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--color-border-subtle);
    color: var(--color-text-tertiary);
    display: none;
  }

  @media (min-width: 640px) {
    .iq-search-label,
    .iq-search-kbd {
      display: inline;
    }

    .iq-search {
      width: auto;
      padding: 0 0.875rem;
    }
  }

  @media (min-width: 1024px) {
    .iq-header-inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      column-gap: clamp(0.75rem, 1.5vw, 1.5rem);
      padding: 0 clamp(1.5rem, 2vw, 2rem);
    }

    .iq-logo {
      justify-self: start;
    }

    .iq-nav {
      display: flex;
      gap: clamp(0.25rem, 1vw, 1rem);
    }

    .iq-search {
      justify-self: end;
      margin-left: 0;
    }
  }

  @media (min-width: 1024px) and (max-width: 1279px) {
    .iq-search {
      width: 44px;
      padding: 0;
    }

    .iq-search-label,
    .iq-search-kbd {
      display: none;
    }
  }
</style>
