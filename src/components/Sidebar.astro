---
/**
 * Sidebar — fixed 좌측 트리 네비게이션 (4단계 계층)
 *
 * 구조:
 *   Category (Dev | AI | Agent)
 *     └─ Group (Dev: Backend Deep Dive 9그룹 / AI: 11 레이어)
 *         └─ Series (레포 단위, repo.slug == post.series.slug)
 *             └─ Post #1 (series.order 오름차순)
 *
 * Positioning:
 *   - position: fixed; top: header-height; left: 0; bottom: 0;
 *   - 스크롤·페이지 이동 무관 viewport에 항상 고정
 *   - body padding-left로 main을 옆으로 밀어냄 (collapsed/expanded 동기화)
 *
 * 동작:
 *   - collapsed (default 56px): 토글 아이콘만 보임
 *   - expanded (300px): 트리 풀 노출
 *   - localStorage('iq-sidebar-expanded') 영속화
 *   - 현재 글 페이지: 해당 카테고리·그룹·시리즈 자동 펼침 + 글 항목 강조
 *
 * 자동 갱신:
 *   - getCollection() build 타임 스캔 → 새 글 추가 시 자동 반영
 *   - DEV_LAB_GROUPS / AI_LAB_LAYERS (consts.ts)에서 그룹·레포 메타 읽음
 *   - 글 0개 시리즈는 표시 안 함, 글 0개 그룹도 자동 숨김
 */

import { getCollection } from 'astro:content';
import { DEV_LAB_GROUPS, AI_LAB_LAYERS } from '@/consts';
import Icon from '@/components/Icon.astro';

type Category = 'dev' | 'ai' | 'agent';

interface PostMeta {
  slug: string;
  title: string;
  pubDate: Date;
  seriesSlug?: string;
  seriesTitle?: string;
  seriesOrder?: number;
}

const CATEGORY_LABEL: Record<Category, string> = {
  ai: 'AI',
  dev: 'Dev',
  agent: 'Agent',
};

const CATEGORY_COLOR: Record<Category, string> = {
  dev: '#22D3EE',
  ai: '#A78BFA',
  agent: '#F59E0B',
};

// 1. 모든 글 fetch (draft 제외)
const allPosts = await getCollection('posts', ({ data }) => !data.draft);

// 2. 현재 페이지 slug
const pathMatch = Astro.url.pathname.match(/^\/posts\/([^/]+)\/?$/);
const currentSlug = pathMatch?.[1];

// 3. 카테고리별 + seriesSlug별 인덱스
const postsBySeries = new Map<string, PostMeta[]>();
const postsByCategory: Record<Category, PostMeta[]> = { ai: [], dev: [], agent: [] };
for (const p of allPosts) {
  const meta: PostMeta = {
    slug: p.id,
    title: p.data.title,
    pubDate: p.data.pubDate,
    seriesSlug: p.data.series?.slug,
    seriesTitle: p.data.series?.title,
    seriesOrder: p.data.series?.order,
  };
  postsByCategory[p.data.category].push(meta);
  if (meta.seriesSlug) {
    const list = postsBySeries.get(meta.seriesSlug) ?? [];
    list.push(meta);
    postsBySeries.set(meta.seriesSlug, list);
  }
}

// 각 series 안 글 정렬
for (const list of postsBySeries.values()) {
  list.sort((a, b) => (a.seriesOrder ?? 0) - (b.seriesOrder ?? 0));
}

// 4. Dev/AI 그룹 데이터 빌드 (consts 기반 + 글 0개 필터)
type SeriesNode = {
  slug: string;
  title: string;
  posts: PostMeta[];
  hasCurrent: boolean;
};
type GroupNode = {
  title: string;
  slug: string;
  icon: string;
  color: string;
  description: string;
  series: SeriesNode[];
  total: number;
  hasCurrent: boolean;
  layer?: string;
};

function buildGroup(group: { title: string; slug: string; icon: string; color: string; description: string; repos: { slug: string; title: string }[] }, layer?: string): GroupNode | null {
  const series: SeriesNode[] = [];
  for (const repo of group.repos) {
    const posts = postsBySeries.get(repo.slug) ?? [];
    if (posts.length === 0) continue; // 양산 안 된 레포 숨김
    const hasCurrent = !!currentSlug && posts.some((p) => p.slug === currentSlug);
    series.push({ slug: repo.slug, title: repo.title, posts, hasCurrent });
  }
  if (series.length === 0) return null;
  const total = series.reduce((s, g) => s + g.posts.length, 0);
  const hasCurrent = series.some((s) => s.hasCurrent);
  return { ...group, series, total, hasCurrent, layer };
}

const devGroups: GroupNode[] = DEV_LAB_GROUPS
  .map((g) => buildGroup(g))
  .filter((g): g is GroupNode => g !== null);

const aiGroups: GroupNode[] = AI_LAB_LAYERS
  .map((l) => buildGroup(l, l.layer))
  .filter((g): g is GroupNode => g !== null);

// Agent 카테고리: 그룹/시리즈 없으니 단순 글 목록
const agentPosts = postsByCategory.agent
  .slice()
  .sort((a, b) => b.pubDate.getTime() - a.pubDate.getTime());

const totals = {
  dev: postsByCategory.dev.length,
  ai: postsByCategory.ai.length,
  agent: postsByCategory.agent.length,
};

const hasCurrentInCat: Record<Category, boolean> = {
  dev: !!currentSlug && postsByCategory.dev.some((p) => p.slug === currentSlug),
  ai: !!currentSlug && postsByCategory.ai.some((p) => p.slug === currentSlug),
  agent: !!currentSlug && postsByCategory.agent.some((p) => p.slug === currentSlug),
};
---

{/* 모바일 전용 햄버거 — fixed 좌상단, 데스크톱에선 hidden */}
<button
  type="button"
  class="mobile-hamburger"
  data-sidebar-toggle
  aria-label="목차 열기"
  aria-controls="iq-sidebar-content"
>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <line x1="3" y1="6" x2="21" y2="6" />
    <line x1="3" y1="12" x2="21" y2="12" />
    <line x1="3" y1="18" x2="21" y2="18" />
  </svg>
</button>

{/* 모바일 backdrop — 사이드바 expanded 시 본문 위에 어두운 overlay */}
<div class="sidebar-backdrop" data-sidebar-toggle aria-hidden="true"></div>

<aside class="sidebar" id="iq-sidebar" data-state="collapsed" aria-label="Site navigation">
  <button
    type="button"
    class="sidebar-toggle"
    data-sidebar-toggle
    aria-label="목차 열기/닫기"
    aria-expanded="false"
    aria-controls="iq-sidebar-content"
  >
    <svg class="icon-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="3" y1="6" x2="21" y2="6" />
      <line x1="3" y1="12" x2="21" y2="12" />
      <line x1="3" y1="18" x2="21" y2="18" />
    </svg>
    <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="18" y1="6" x2="6" y2="18" />
      <line x1="6" y1="6" x2="18" y2="18" />
    </svg>
    <span class="toggle-label">목차</span>
  </button>

  <div class="sidebar-content" id="iq-sidebar-content">
    <div class="sidebar-meta">
      <span class="sidebar-meta-label">전체 글</span>
      <span class="sidebar-meta-count">{allPosts.length}</span>
    </div>

    <nav class="sidebar-tree">
      {/* ─────── Dev ─────── */}
      {devGroups.length > 0 && (
        <details class="cat-group cat-dev" open={hasCurrentInCat.dev} style={`--cat-color: ${CATEGORY_COLOR.dev};`}>
          <summary class="cat-summary">
            <span class="cat-bar" aria-hidden="true"></span>
            <svg class="chevron" viewBox="0 0 12 12" aria-hidden="true">
              <polyline points="4,2 8,6 4,10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="cat-label">{CATEGORY_LABEL.dev}</span>
            <span class="cat-count">{totals.dev}</span>
          </summary>

          <div class="cat-body">
            {devGroups.map((g) => (
              <details class="group-block" open={g.hasCurrent} style={`--group-color: ${g.color};`}>
                <summary class="group-summary">
                  <svg class="chevron chevron-sm" viewBox="0 0 12 12" aria-hidden="true">
                    <polyline points="4,2 8,6 4,10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <span class="group-icon" aria-hidden="true" style={`color: ${g.color};`}>
                    <Icon name={g.icon as any} size={14} />
                  </span>
                  <span class="group-title">{g.title}</span>
                  <span class="group-count">{g.series.length}</span>
                </summary>
                <div class="group-body">
                  {g.series.map((s) => (
                    <details class="series-group" open={s.hasCurrent}>
                      <summary class="series-summary">
                        <svg class="chevron chevron-xs" viewBox="0 0 12 12" aria-hidden="true">
                          <polyline points="4,2 8,6 4,10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        <span class="series-title">{s.title}</span>
                        <span class="series-count">{s.posts.length}</span>
                      </summary>
                      <ol class="post-list">
                        {s.posts.map((p) => (
                          <li>
                            <a href={`/posts/${p.slug}/`} class={p.slug === currentSlug ? 'post-link active' : 'post-link'}>
                              <span class="post-order">{p.seriesOrder}</span>
                              <span class="post-title">{p.title}</span>
                            </a>
                          </li>
                        ))}
                      </ol>
                    </details>
                  ))}
                </div>
              </details>
            ))}
          </div>
        </details>
      )}

      {/* ─────── AI ─────── */}
      {aiGroups.length > 0 && (
        <details class="cat-group cat-ai" open={hasCurrentInCat.ai} style={`--cat-color: ${CATEGORY_COLOR.ai};`}>
          <summary class="cat-summary">
            <span class="cat-bar" aria-hidden="true"></span>
            <svg class="chevron" viewBox="0 0 12 12" aria-hidden="true">
              <polyline points="4,2 8,6 4,10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="cat-label">{CATEGORY_LABEL.ai}</span>
            <span class="cat-count">{totals.ai}</span>
          </summary>

          <div class="cat-body">
            {aiGroups.map((g) => (
              <details class="group-block" open={g.hasCurrent} style={`--group-color: ${g.color};`}>
                <summary class="group-summary">
                  <svg class="chevron chevron-sm" viewBox="0 0 12 12" aria-hidden="true">
                    <polyline points="4,2 8,6 4,10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <span class="group-icon" aria-hidden="true" style={`color: ${g.color};`}>
                    <Icon name={g.icon as any} size={14} />
                  </span>
                  <span class="group-title">
                    {g.layer && <span class="group-layer">L{g.layer}</span>}
                    {g.title}
                  </span>
                  <span class="group-count">{g.series.length}</span>
                </summary>
                <div class="group-body">
                  {g.series.map((s) => (
                    <details class="series-group" open={s.hasCurrent}>
                      <summary class="series-summary">
                        <svg class="chevron chevron-xs" viewBox="0 0 12 12" aria-hidden="true">
                          <polyline points="4,2 8,6 4,10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        <span class="series-title">{s.title}</span>
                        <span class="series-count">{s.posts.length}</span>
                      </summary>
                      <ol class="post-list">
                        {s.posts.map((p) => (
                          <li>
                            <a href={`/posts/${p.slug}/`} class={p.slug === currentSlug ? 'post-link active' : 'post-link'}>
                              <span class="post-order">{p.seriesOrder}</span>
                              <span class="post-title">{p.title}</span>
                            </a>
                          </li>
                        ))}
                      </ol>
                    </details>
                  ))}
                </div>
              </details>
            ))}
          </div>
        </details>
      )}

      {/* ─────── Agent ─────── */}
      {agentPosts.length > 0 && (
        <details class="cat-group cat-agent" open={hasCurrentInCat.agent} style={`--cat-color: ${CATEGORY_COLOR.agent};`}>
          <summary class="cat-summary">
            <span class="cat-bar" aria-hidden="true"></span>
            <svg class="chevron" viewBox="0 0 12 12" aria-hidden="true">
              <polyline points="4,2 8,6 4,10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="cat-label">{CATEGORY_LABEL.agent}</span>
            <span class="cat-count">{totals.agent}</span>
          </summary>

          <div class="cat-body">
            <ul class="post-list direct">
              {agentPosts.map((p) => (
                <li>
                  <a href={`/posts/${p.slug}/`} class={p.slug === currentSlug ? 'post-link active' : 'post-link'}>
                    <span class="post-title">{p.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </details>
      )}
    </nav>
  </div>
</aside>

<script is:inline>
  (function () {
    const STORAGE_KEY = 'iq-sidebar-expanded';
    const sidebar = document.getElementById('iq-sidebar');
    if (!sidebar) return;

    const isMobile = () => window.matchMedia('(max-width: 1023px)').matches;

    const setState = (expanded) => {
      sidebar.dataset.state = expanded ? 'expanded' : 'collapsed';
      document.body.dataset.sidebarExpanded = String(expanded);
      sidebar.querySelectorAll('[data-sidebar-toggle]').forEach((btn) => {
        btn.setAttribute('aria-expanded', String(expanded));
      });
      // 모바일은 localStorage 저장 안 함 — 매번 collapsed로 시작 (UX)
      if (!isMobile()) {
        try { localStorage.setItem(STORAGE_KEY, String(expanded)); } catch {}
      }
    };

    // 초기 상태: 모바일은 항상 collapsed, 데스크톱은 localStorage
    let initial = false;
    if (!isMobile()) {
      try {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (saved === 'true') initial = true;
      } catch {}
    }
    setState(initial);

    // 모든 [data-sidebar-toggle] (사이드바 안 토글, 모바일 햄버거, 백드롭) 통합 처리
    document.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;
      const toggle = target.closest('[data-sidebar-toggle]');
      if (!toggle) return;
      // backdrop 클릭은 항상 close
      if (toggle.classList.contains('sidebar-backdrop')) {
        setState(false);
      } else {
        setState(sidebar.dataset.state !== 'expanded');
      }
    });

    // ESC 키로 모바일에서 닫기
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isMobile() && sidebar.dataset.state === 'expanded') {
        setState(false);
      }
    });

    // viewport resize 시 모바일 ↔ 데스크톱 전환 대응
    window.matchMedia('(max-width: 1023px)').addEventListener('change', () => {
      // 모바일로 진입하면 collapsed로 강제 (overlay이라 본문 가리기 방지)
      if (isMobile()) setState(false);
    });
  })();
</script>

<style is:global>
  /* 데스크톱 — 사이드바가 본문 옆으로 push */
  @media (min-width: 1024px) {
    body {
      padding-left: 56px;
      transition: padding-left 0.22s cubic-bezier(0.4, 0, 0.2, 1);
    }
    body[data-sidebar-expanded="true"] {
      padding-left: 300px;
    }
  }

  /* 모바일 — overlay 모드라 본문 padding 변화 X, scroll lock 추가 */
  @media (max-width: 1023px) {
    body[data-sidebar-expanded="true"] {
      overflow: hidden;
    }
  }
</style>

<style>
  /* ──────────────────────────────────────────────────────────
     레이아웃
     - 데스크톱(≥1024px): fixed sidebar, collapsed 56px ↔ expanded 300px (본문 옆으로 push)
     - 모바일(<1024px): drawer overlay, transform translateX로 슬라이드 인/아웃
     ────────────────────────────────────────────────────────── */
  .sidebar {
    display: flex;
    flex-direction: column;
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    background: linear-gradient(180deg, #0a0e1a 0%, #0f1424 100%);
    border-right: 1px solid var(--color-border-subtle, #374151);
    overflow: hidden;
  }

  /* 모바일 — drawer 모드 */
  @media (max-width: 1023px) {
    .sidebar {
      width: 85vw;
      max-width: 320px;
      transform: translateX(-100%);
      transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      z-index: 50;
    }
    .sidebar[data-state="expanded"] {
      transform: translateX(0);
      box-shadow: 4px 0 24px rgba(0, 0, 0, 0.5);
    }
    /* 모바일에선 사이드바 안 .sidebar-toggle은 close 역할 — close 아이콘 + 라벨 항상 보임 */
    .sidebar > .sidebar-toggle .icon-menu { display: none; }
    .sidebar > .sidebar-toggle .icon-close { display: block; }
    .sidebar > .sidebar-toggle .toggle-label {
      opacity: 1;
      transition-delay: 0s;
    }
    /* 모바일에선 사이드바 안에서 항상 트리 표시 (collapsed/expanded 구분 없음) */
    .sidebar .sidebar-content {
      opacity: 1;
      pointer-events: auto;
    }
  }

  /* 데스크톱 — 기존 collapsed/expanded width 토글 */
  @media (min-width: 1024px) {
    .sidebar {
      width: 56px;
      transition: width 0.22s cubic-bezier(0.4, 0, 0.2, 1);
      z-index: 30;
    }
    .sidebar[data-state="expanded"] {
      width: 300px;
    }
  }

  /* ──────────────────────────────────────────────────────────
     모바일 햄버거 버튼 — 데스크톱에선 hidden
     ────────────────────────────────────────────────────────── */
  .mobile-hamburger {
    display: none;
  }
  @media (max-width: 1023px) {
    .mobile-hamburger {
      display: flex;
      align-items: center;
      justify-content: center;
      position: fixed;
      top: 14px;
      left: 14px;
      width: 40px;
      height: 40px;
      border: 1px solid var(--color-border-subtle, #374151);
      background: rgba(10, 14, 26, 0.85);
      backdrop-filter: blur(8px);
      color: var(--color-text-primary, #f3f4f6);
      border-radius: 8px;
      cursor: pointer;
      z-index: 49;
      transition: background 0.15s, color 0.15s;
    }
    .mobile-hamburger:hover {
      background: rgba(34, 211, 238, 0.15);
      color: var(--color-accent-cyan, #22d3ee);
    }
    .mobile-hamburger svg {
      width: 20px;
      height: 20px;
    }
    /* 사이드바 expanded 시 햄버거 숨김 (사이드바 안 close 버튼 사용) */
    .sidebar[data-state="expanded"] ~ .mobile-hamburger {
      opacity: 0;
      pointer-events: none;
    }
  }

  /* ──────────────────────────────────────────────────────────
     모바일 backdrop — 사이드바 expanded 시 본문 위 어두운 overlay
     ────────────────────────────────────────────────────────── */
  .sidebar-backdrop {
    display: none;
  }
  @media (max-width: 1023px) {
    .sidebar-backdrop {
      display: block;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.55);
      backdrop-filter: blur(2px);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease;
      z-index: 45;
    }
    .sidebar[data-state="expanded"] ~ .sidebar-backdrop {
      opacity: 1;
      pointer-events: auto;
    }
  }

  /* ──────────────────────────────────────────────────────────
     Toggle button
     ────────────────────────────────────────────────────────── */
  .sidebar-toggle {
    appearance: none;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--color-border-subtle, #374151);
    color: var(--color-text-secondary, #9ca3af);
    width: 100%;
    /* Header와 정확히 동일 높이 — 바닥선 align */
    height: var(--iq-header-height, 65px);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0 1rem;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
    flex-shrink: 0;
    box-sizing: border-box;
  }
  .sidebar-toggle:hover {
    background: rgba(34, 211, 238, 0.06);
    color: var(--color-accent-cyan, #22d3ee);
  }
  .sidebar-toggle svg {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
  }

  .icon-menu { display: block; }
  .icon-close { display: none; }
  .sidebar[data-state="expanded"] .icon-menu { display: none; }
  .sidebar[data-state="expanded"] .icon-close { display: block; }

  .toggle-label {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    opacity: 0;
    transition: opacity 0.15s;
    white-space: nowrap;
  }
  .sidebar[data-state="expanded"] .toggle-label {
    opacity: 1;
    transition-delay: 0.12s;
  }

  /* ──────────────────────────────────────────────────────────
     Content
     ────────────────────────────────────────────────────────── */
  .sidebar-content {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 0.5rem 0 1.5rem 0;
    opacity: 0;
    transition: opacity 0.15s;
    pointer-events: none;
  }
  .sidebar[data-state="expanded"] .sidebar-content {
    opacity: 1;
    transition-delay: 0.1s;
    pointer-events: auto;
