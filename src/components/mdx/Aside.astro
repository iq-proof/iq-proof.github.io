---
interface Props {
  label?: string;
}

const { label = 'Aside' } = Astro.props;
---

<aside
  class="my-5 pl-4 py-1"
  style="border-left: 2px solid var(--color-border-strong); color: var(--color-text-tertiary); font-size: 0.92em; line-height: 1.7;"
>
  <div class="mono-label mb-1" style="color: var(--color-text-tertiary);">
    ✎ {label}
  </div>
  <slot />
</aside>
