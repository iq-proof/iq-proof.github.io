---
interface Props {
  title?: string;
}

const { title = '증명' } = Astro.props;
---

<div
  class="my-6 px-5 py-4 rounded-md"
  style="background: rgba(0, 0, 0, 0.2); border: 1px solid var(--color-border-subtle);"
>
  <div class="flex items-center gap-2 mb-2">
    <span class="mono-label" style="color: var(--color-text-tertiary);">
      ▷ {title}
    </span>
  </div>
  <div style="color: var(--color-text-secondary); line-height: 1.8;">
    <slot />
  </div>
  <div class="text-right mt-2" style="color: var(--color-accent-cyan); font-size: 1.1em;">
    ∎
  </div>
</div>
