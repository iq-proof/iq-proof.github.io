---
interface Props {
  title: string;
  defaultOpen?: boolean;
}

const { title, defaultOpen = false } = Astro.props;
---

<details
  class="my-5 rounded-md group"
  style="background: var(--color-surface); border: 1px solid var(--color-border-subtle); overflow: hidden;"
  open={defaultOpen || undefined}
>
  <summary
    class="px-4 py-3 cursor-pointer select-none flex items-center gap-2 transition-colors"
    style="color: var(--color-text-primary); font-size: 0.95em;"
  >
    <span
      class="font-mono text-xs transition-transform group-open:rotate-90"
      style="color: var(--color-accent-cyan); display: inline-block;"
    >
      ▸
    </span>
    <span>{title}</span>
  </summary>
  <div
    class="px-4 py-3"
    style="border-top: 1px solid var(--color-border-subtle); color: var(--color-text-secondary); line-height: 1.8;"
  >
    <slot />
  </div>
</details>
