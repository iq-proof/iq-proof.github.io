---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CategoryBadge from '@/components/CategoryBadge.astro';
import DifficultyBadge from '@/components/DifficultyBadge.astro';
import TagPill from '@/components/TagPill.astro';
import Giscus from '@/components/Giscus.astro';
import type { Post } from '@/utils/posts';
import {
  formatDate,
  getReadingTime,
  getSeriesNeighbors,
  getPostsBySeries,
} from '@/utils/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { minutes } = getReadingTime(post.body ?? '');
const { prev, next } = await getSeriesNeighbors(post);
const seriesSiblings = post.data.series
    ? await getPostsBySeries(post.data.series.slug)
    : [];
---

<BaseLayout
    title={post.data.title}
    description={post.data.description}
    ogImage={`/og/${post.id}.png`}
    pubDate={post.data.pubDate}
    updatedDate={post.data.updatedDate}
    ogType="article"
    tags={post.data.tags}
    category={post.data.category}
>
  <article class="mx-auto px-6 pt-16 pb-12" style="max-width: var(--reading-max);">
    <!-- Back to posts -->
    <a
        href="/posts"
        class="inline-flex items-center gap-1 font-mono text-xs mb-8 transition-colors"
        style="color: var(--color-text-tertiary);"
    >
      ← all posts
    </a>

    <!-- Meta row -->
    <div class="flex flex-wrap items-center gap-2 mb-5">
      <CategoryBadge category={post.data.category} size="md" />
      <span class="font-mono text-xs" style="color: var(--color-text-tertiary);">
        {formatDate(post.data.pubDate)} · {minutes} min read
      </span>
      {post.data.difficulty && <DifficultyBadge level={post.data.difficulty} />}
    </div>

    <!-- Title & description -->
    <h1
        class="text-3xl md:text-[2rem] font-medium mb-4"
        style="letter-spacing: -0.025em; line-height: 1.3; color: var(--color-text-primary);"
    >
      {post.data.title}
    </h1>
    <p class="text-base mb-6" style="color: var(--color-text-secondary); line-height: 1.7;">
      {post.data.description}
    </p>

    <!-- Series banner -->
    {
        post.data.series && (
            <div
                class="px-4 py-3 mb-8 rounded-md"
                style="background: var(--color-surface); border: 1px solid var(--color-border-subtle);"
            >
              <div class="flex items-center justify-between mb-2">
                <a
                    href={`/series/${post.data.series.slug}`}
                    class="font-mono text-[11px] transition-colors"
                    style="color: var(--color-accent-cyan);"
                >
                  📚 {post.data.series.title}
                </a>
                <span class="font-mono text-[11px]" style="color: var(--color-text-tertiary);">
              {post.data.series.order} / {seriesSiblings.length}
            </span>
              </div>
              <ol class="space-y-1 text-sm" style="color: var(--color-text-secondary);">
                {
                  seriesSiblings.map((sibling) => (
                      <li class="flex gap-2">
                  <span
                      class="font-mono text-xs"
                      style={`color: ${
                          sibling.id === post.id
                              ? 'var(--color-accent-cyan)'
                              : 'var(--color-text-tertiary)'
                      };`}
                  >
                    {String(sibling.data.series!.order).padStart(2, '0')}
                  </span>
                        {sibling.id === post.id ? (
                            <span style="color: var(--color-text-primary);">{sibling.data.title}</span>
                        ) : (
                            <a
                                href={`/posts/${sibling.id}`}
                                class="transition-colors hover:text-[var(--color-accent-cyan)]"
                            >
                              {sibling.data.title}
                            </a>
                        )}
                      </li>
                  ))
                }
              </ol>
            </div>
        )
    }

    <hr style="border: none; border-top: 1px solid var(--color-border-subtle); margin: 1.5rem 0 2.5rem;" />

    <!-- Body -->
    <div class="prose">
      <slot />
    </div>

    <!-- Tags -->
    {
        post.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-2 mt-12 pt-6" style="border-top: 1px solid var(--color-border-subtle);">
              {post.data.tags.map((tag) => <TagPill tag={tag} />)}
            </div>
        )
    }

    <!-- Updated note -->
    {
        post.data.updatedDate && (
            <p class="font-mono text-xs mt-6" style="color: var(--color-text-tertiary);">
              // last updated: {formatDate(post.data.updatedDate)}
            </p>
        )
    }

    <!-- Series prev/next -->
    {
        (prev || next) && (
            <nav class="mt-12 pt-6 grid grid-cols-1 md:grid-cols-2 gap-4" style="border-top: 1px solid var(--color-border-subtle);">
              {prev ? (
                  <a
                      href={`/posts/${prev.id}`}
                      class="p-4 rounded-md transition-colors"
                      style="background: var(--color-surface); border: 1px solid var(--color-border-subtle);"
                  >
                    <div class="font-mono text-[11px] mb-1" style="color: var(--color-text-tertiary);">
                      ← previous
                    </div>
                    <div class="text-sm" style="color: var(--color-text-primary);">
                      {prev.data.title}
                    </div>
                  </a>
              ) : (
                  <div />
              )}
              {next ? (
                  <a
                      href={`/posts/${next.id}`}
                      class="p-4 rounded-md transition-colors text-right"
                      style="background: var(--color-surface); border: 1px solid var(--color-border-subtle);"
                  >
                    <div class="font-mono text-[11px] mb-1" style="color: var(--color-text-tertiary);">
                      next →
                    </div>
                    <div class="text-sm" style="color: var(--color-text-primary);">
                      {next.data.title}
                    </div>
                  </a>
              ) : (
                  <div />
              )}
            </nav>
        )
    }

    <!-- Comments — Giscus (GitHub Discussions) -->
    <section id="comments" class="mt-16 pt-8" style="border-top: 1px solid var(--color-border-subtle);">
      <Giscus />
    </section>
  </article>
</BaseLayout>
