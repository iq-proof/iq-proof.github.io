---
import { SITE } from '@/consts';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Sidebar from '@/components/Sidebar.astro';
import GoatCounter from '@/components/GoatCounter.astro';
import SearchModal from '@/components/SearchModal.astro';
import JsonLd from '@/components/JsonLd.astro';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  pubDate?: Date;
  updatedDate?: Date;
  ogType?: 'website' | 'article';
  tags?: string[];
  category?: 'dev' | 'ai' | 'agent';
}

const {
  title,
  description = SITE.description,
  ogImage = '/og-default.png',
  pubDate,
  updatedDate,
  ogType = 'website',
  tags,
  category,
} = Astro.props;

const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const resolvedOgImage = new URL(ogImage, Astro.site).toString();
---
<!doctype html>
<html lang={SITE.lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Favicon & icons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" content="#0a0e1a" />

  <!-- Open Graph -->
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={resolvedOgImage} />
  <meta property="og:locale" content={SITE.locale} />
  {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
  {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={resolvedOgImage} />

  <!-- RSS -->
  <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />

  <!-- Sitemap -->
  <link rel="sitemap" href="/sitemap-index.xml" />

  <!-- Structured data -->
  <JsonLd
      type={ogType}
      title={fullTitle}
      description={description}
      url={canonicalURL}
      image={resolvedOgImage}
      pubDate={pubDate}
      updatedDate={updatedDate}
      tags={tags}
  />
</head>
<body class="min-h-screen flex flex-col" data-category={category}>
<!-- Ink drops: occasional subtle blooms at edges -->
<span class="ink-drop ink-drop-1" aria-hidden="true"></span>
<span class="ink-drop ink-drop-2" aria-hidden="true"></span>
<span class="ink-drop ink-drop-3" aria-hidden="true"></span>

<Header />
<div class="layout-shell">
  <Sidebar />
  <main class="flex-1 min-w-0">
    <slot />
  </main>
</div>
<Footer />

<style is:global>
  .layout-shell {
    display: flex;
    flex: 1 1 auto;
    width: 100%;
    align-items: stretch;
    /* main이 짧은 페이지(archive, 404 등)에서도 sidebar sticky 영역이
       viewport 풀 높이로 유지되도록 min-height 보장 */
    min-height: calc(100vh - 4rem);
  }
</style>
<SearchModal />
<GoatCounter />
</body>
</html>
