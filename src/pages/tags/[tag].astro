---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getAllTags, getPostsByTag } from '@/utils/posts';

export async function getStaticPaths() {
  const tags = await getAllTags();
  return tags.map(({ tag }) => ({
    params: { tag },
    props: { tag },
  }));
}

interface Props {
  tag: string;
}

const { tag } = Astro.props;
const posts = await getPostsByTag(tag);
---

<BaseLayout title={`#${tag}`} description={`Posts tagged with ${tag}.`}>
  <section class="mx-auto px-6 pt-16 pb-10" style="max-width: var(--container-max);">
    <div class="mono-label mb-2" style="color: var(--color-accent-cyan);">
      // tag
    </div>
    <h1 class="text-3xl font-medium mb-3" style="letter-spacing: -0.025em; color: var(--color-text-primary);">
      <span style="color: var(--color-text-tertiary);">#</span>{tag}
    </h1>
    <p class="text-sm" style="color: var(--color-text-tertiary);">
      총 {posts.length}개의 글
    </p>
  </section>

  <section class="mx-auto px-6 pb-16" style="max-width: var(--container-max);">
    {posts.map((post) => <PostCard post={post} />)}
  </section>
</BaseLayout>
