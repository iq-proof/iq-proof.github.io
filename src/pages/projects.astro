---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CursorLight from '@/components/CursorLight.astro';
import CategoryHeader from '@/components/CategoryHeader.astro';
import RepoRow from '@/components/RepoRow.astro';
import { DEV_LAB_GROUPS, AI_LAB_LAYERS, SOCIAL } from '@/consts';

const DEV_LAB_REPO_BASE = 'https://github.com/iq-dev-lab';
const AI_LAB_REPO_BASE = 'https://github.com/iq-ai-lab';

const devRepoCount = DEV_LAB_GROUPS.reduce((sum, g) => sum + g.repos.length, 0);
const aiRepoCount = AI_LAB_LAYERS.reduce((sum, l) => sum + l.repos.length, 0);
---

<BaseLayout
    title="Projects"
    description="iq-dev-lab과 iq-ai-lab — 86개 딥다이브 레포지토리로 구축한 백엔드와 AI의 지식 지도"
>
  <CursorLight mode="blend" />
  <div class="mx-auto px-6 pt-16 pb-24" style="max-width: var(--container-max);">
    <!-- Page header -->
    <header class="mb-16 text-center">
      <div
        class="font-mono text-[11px] mb-3"
        style="color: var(--color-text-tertiary); letter-spacing: 2px;"
      >
        ◈ KNOWLEDGE MAP
      </div>
      <h1
        class="text-3xl md:text-4xl font-medium mb-4"
        style="letter-spacing: -0.025em; color: var(--color-text-primary);"
      >
        Projects
      </h1>
      <p class="text-base mx-auto mb-2" style="color: var(--color-text-primary); max-width: 560px; line-height: 1.7;">
        본질을 파고드는 공간들.
      </p>
      <p class="text-sm mx-auto" style="color: var(--color-text-secondary); max-width: 560px; line-height: 1.7;">
        이 블로그의 글은 아래 {devRepoCount + aiRepoCount}개의 저장소에서 자랍니다.
      </p>
      <p
        class="font-mono text-[11px] mt-5"
        style="color: var(--color-text-tertiary); letter-spacing: 0.5px;"
      >
        카테고리를 클릭해 펼치기 ↓
      </p>
    </header>

    <!-- ═════════════════════════════════════════════════════
         IQ DEV LAB
         ═════════════════════════════════════════════════════ -->
    <section class="mb-20">
      <!-- Section header -->
      <div
        class="flex items-start justify-between gap-4 mb-8 pb-5"
        style="border-bottom: 1px solid var(--color-border-subtle);"
      >
        <div>
          <div
            class="font-mono text-[11px] mb-2"
            style="color: var(--color-accent-cyan); letter-spacing: 2px;"
          >
            IQ-DEV-LAB
          </div>
          <h2
            class="text-2xl font-medium mb-2"
            style="letter-spacing: -0.02em; color: var(--color-text-primary);"
          >
            Backend Deep Dive
          </h2>
          <p
            class="text-sm"
            style="color: var(--color-text-tertiary); line-height: 1.6;"
          >
            Java·Spring·DB·Infra의 내부를 파헤치는 {devRepoCount}개 레포
          </p>
        </div>
        <div class="flex items-center gap-3 flex-shrink-0 mt-2">
          <a
            href={SOCIAL.devLabSite}
            target="_blank"
            rel="noopener noreferrer"
            class="font-mono text-xs transition-colors hover:underline"
            style="color: var(--color-accent-cyan);"
          >
            ↗ site
          </a>
          <a
            href={SOCIAL.devLab}
            target="_blank"
            rel="noopener noreferrer"
            class="font-mono text-xs transition-colors hover:underline"
            style="color: var(--color-text-tertiary);"
          >
            ↗ github
          </a>
        </div>
      </div>

      <!-- Category list (collapsible) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-2">
        {DEV_LAB_GROUPS.map((group) => (
          <details
            id={`dev-${group.slug}`}
            class="category-block"
            style={`--cat-color: ${group.color};`}
          >
            <summary class="category-summary">
              <CategoryHeader
                icon={group.icon}
                color={group.color}
                title={group.title}
                description={group.description}
                count={group.repos.length}
                collapsible
              />
            </summary>
            <div class="repo-list py-2 pl-2">
              {group.repos.map((repo) => (
                <RepoRow
                  href={`${DEV_LAB_REPO_BASE}/${repo.slug}`}
                  slug={repo.slug}
                  title={repo.title}
                  description={repo.description}
                  color={group.color}
                />
              ))}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- ═════════════════════════════════════════════════════
         IQ AI LAB
         ═════════════════════════════════════════════════════ -->
    <section>
      <!-- Section header -->
      <div
        class="flex items-start justify-between gap-4 mb-8 pb-5"
        style="border-bottom: 1px solid var(--color-border-subtle);"
      >
        <div>
          <div
            class="font-mono text-[11px] mb-2"
            style="color: var(--color-accent-violet); letter-spacing: 2px;"
          >
            IQ-AI-LAB
          </div>
          <h2
            class="text-2xl font-medium mb-2"
            style="letter-spacing: -0.02em; color: var(--color-text-primary);"
          >
            AI Foundations
          </h2>
          <p
            class="text-sm"
            style="color: var(--color-text-tertiary); line-height: 1.6;"
          >
            수학에서 Frontier LLM까지 — {AI_LAB_LAYERS.length}개 레이어 {aiRepoCount}개 레포
          </p>
        </div>
        <div class="flex items-center gap-3 flex-shrink-0 mt-2">
          <a
            href={SOCIAL.aiLabSite}
            target="_blank"
            rel="noopener noreferrer"
            class="font-mono text-xs transition-colors hover:underline"
            style="color: var(--color-accent-violet);"
          >
            ↗ site
          </a>
          <a
            href={SOCIAL.aiLab}
            target="_blank"
            rel="noopener noreferrer"
            class="font-mono text-xs transition-colors hover:underline"
            style="color: var(--color-text-tertiary);"
          >
            ↗ github
          </a>
        </div>
      </div>

      <!-- Layers (collapsible) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-2">
        {AI_LAB_LAYERS.map((layer) => (
          <details
            id={`ai-${layer.slug}`}
            class="category-block"
            style={`--cat-color: ${layer.color};`}
          >
            <summary class="category-summary">
              <CategoryHeader
                icon={layer.icon}
                color={layer.color}
                title={layer.title}
                description={layer.description}
                count={layer.repos.length}
                layer={layer.layer}
                collapsible
              />
            </summary>
            <div class="repo-list py-2 pl-2">
              {layer.repos.map((repo) => (
                  <RepoRow
                  href={`${AI_LAB_REPO_BASE}/${repo.slug}`}
                  slug={repo.slug}
                  title={repo.title}
                  description={repo.description}
                  color={layer.color}
                />
              ))}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- Footer note -->
    <div
      class="mt-20 pt-8 text-center"
      style="border-top: 1px solid var(--color-border-subtle);"
    >
      <p
        class="font-mono text-[11px] mb-2"
        style="color: var(--color-text-tertiary); letter-spacing: 1.5px;"
      >
        총 {devRepoCount + aiRepoCount}개 레포 · 지속적으로 업데이트
      </p>
      <p class="text-sm" style="color: var(--color-text-tertiary);">
        마인드맵으로 보고 싶다면 →
        <a
          href={SOCIAL.devLabSite}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:underline"
          style="color: var(--color-accent-cyan);"
        >
          Dev Lab
        </a>
        ·
        <a
          href={SOCIAL.aiLabSite}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:underline"
          style="color: var(--color-accent-violet);"
        >
          AI Lab
        </a>
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .category-block {
    scroll-margin-top: 5rem;
  }

  .category-summary {
    list-style: none;
    cursor: pointer;
    user-select: none;
    padding: 0.25rem 0;
    border-radius: 6px;
    transition: background 0.15s;
  }

  /* Remove native markers */
  .category-summary::-webkit-details-marker,
  .category-summary::marker {
    display: none;
    content: '';
  }

  /* Smooth expand animation via CSS grid trick would add complexity;
     details tag snaps open/close which is fine for our minimal aesthetic. */

  /* Open state — slight left border accent */
  details[open] > .category-summary {
    background: transparent;
  }

  details[open] .repo-list {
    animation: fadeIn 0.3s ease-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Reduce motion */
  @media (prefers-reduced-motion: reduce) {
    details[open] .repo-list {
      animation: none;
    }
  }
</style>
