---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE, SOCIAL, DEV_LAB_GROUPS, AI_LAB_LAYERS } from '@/consts';

// Totals for header copy
const devLabTotal = DEV_LAB_GROUPS.reduce((sum, g) => sum + g.repos.length, 0);
const aiLabTotal = AI_LAB_LAYERS.reduce((sum, l) => sum + l.repos.length, 0);
---

<BaseLayout title="Projects" description="Companion deep-dive repositories in iq-dev-lab and iq-ai-lab.">
  <section class="mx-auto px-6 pt-16 pb-10" style="max-width: var(--container-max);">
    <div class="mono-label mb-2" style="color: var(--color-accent-cyan);">
      projects · companion repos
    </div>
    <h1 class="text-3xl font-medium mb-4" style="letter-spacing: -0.025em; color: var(--color-text-primary);">
      Projects
    </h1>
    <p class="text-sm" style="color: var(--color-text-secondary); line-height: 1.7; max-width: 40rem;">
      블로그 글과 짝을 이루는 두 개의 딥다이브 저장소. 글은 짧게, 저장소는 깊게.
    </p>
    <p class="text-xs mt-3 font-mono" style="color: var(--color-text-tertiary);">
      iq-dev-lab · {devLabTotal} repos &nbsp;·&nbsp; iq-ai-lab · {aiLabTotal} repos
    </p>
  </section>

  <!-- iq-dev-lab -->
  <section class="mx-auto px-6 pb-10" style="max-width: var(--container-max);">
    <div class="flex items-end justify-between mb-5 flex-wrap gap-3">
      <div>
        <div class="mono-label mb-1" style="color: var(--color-accent-cyan);">
          iq-dev-lab
        </div>
        <h2 class="text-xl font-medium" style="letter-spacing: -0.015em; color: var(--color-text-primary);">
          Backend Deep Dive
        </h2>
      </div>
      <div class="flex items-center gap-3 font-mono text-xs">
        <a
          href={SOCIAL.devLabSite}
          target="_blank"
          rel="noopener"
          class="transition-colors site-link"
          style="color: var(--color-accent-cyan);"
        >
          ↗ site
        </a>
        <span style="color: var(--color-border-subtle);">·</span>
        <a
          href={SOCIAL.devLab}
          target="_blank"
          rel="noopener"
          class="transition-colors"
          style="color: var(--color-text-tertiary);"
        >
          ↗ github
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
      {
        DEV_LAB_GROUPS.map((group) => (
          <details
            class="group-card p-4 rounded-md"
            style="background: var(--color-surface); border: 1px solid var(--color-border-subtle);"
          >
            <summary class="flex items-center justify-between mb-2 cursor-pointer list-none">
              <h3 class="text-sm font-medium" style="color: var(--color-text-primary);">
                {group.title}
              </h3>
              <span class="font-mono text-[11px] flex items-center gap-2" style="color: var(--color-text-tertiary);">
                <span>{group.repos.length} repos</span>
                <span class="toggle-icon">+</span>
              </span>
            </summary>
            <ul class="space-y-1 mt-2">
              {group.repos.map((repo) => (
                <li class="font-mono text-[11px]">
                  <a
                    href={`https://github.com/iq-dev-lab/${repo.slug}`}
                    target="_blank"
                    rel="noopener"
                    style="color: var(--color-accent-cyan);"
                    title={repo.title}
                  >
                    {repo.slug}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ))
      }
    </div>
  </section>

  <!-- iq-ai-lab -->
  <section class="mx-auto px-6 pb-16" style="max-width: var(--container-max);">
    <div class="flex items-end justify-between mb-5 flex-wrap gap-3">
      <div>
        <div class="mono-label mb-1" style="color: var(--color-accent-violet);">
          iq-ai-lab
        </div>
        <h2 class="text-xl font-medium" style="letter-spacing: -0.015em; color: var(--color-text-primary);">
          AI/ML Deep Dive
        </h2>
      </div>
      <div class="flex items-center gap-3 font-mono text-xs">
        <a
          href={SOCIAL.aiLabSite}
          target="_blank"
          rel="noopener"
          class="transition-colors site-link"
          style="color: var(--color-accent-violet);"
        >
          ↗ site
        </a>
        <span style="color: var(--color-border-subtle);">·</span>
        <a
          href={SOCIAL.aiLab}
          target="_blank"
          rel="noopener"
          class="transition-colors"
          style="color: var(--color-text-tertiary);"
        >
          ↗ github
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
      {
        AI_LAB_LAYERS.map((l) => (
          <details
            class="group-card p-4 rounded-md"
            style="background: var(--color-surface); border: 1px solid var(--color-border-subtle);"
          >
            <summary class="flex items-center justify-between mb-1 cursor-pointer list-none">
              <div class="flex items-baseline gap-2">
                <span class="font-mono text-[11px]" style="color: var(--color-accent-violet);">
                  Layer {l.layer}
                </span>
                <h3 class="text-sm font-medium" style="color: var(--color-text-primary);">
                  {l.title}
                </h3>
              </div>
              <span class="font-mono text-[11px] flex items-center gap-2" style="color: var(--color-text-tertiary);">
                <span>{l.repos.length} repos</span>
                <span class="toggle-icon">+</span>
              </span>
            </summary>
            <ul class="space-y-1 mt-2">
              {l.repos.map((repo) => (
                <li class="font-mono text-[11px]">
                  <a
                    href={`https://github.com/iq-ai-lab/${repo.slug}`}
                    target="_blank"
                    rel="noopener"
                    style="color: var(--color-accent-violet);"
                    title={repo.title}
                  >
                    {repo.slug}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ))
      }
    </div>
  </section>

  <!-- Ecosystem -->
  <section
    class="mx-auto px-6 pb-20"
    style="max-width: var(--container-max);"
  >
    <div style="border-top: 1px solid var(--color-border-subtle); padding-top: 2.5rem;">
      <div class="mono-label mb-2" style="color: var(--color-text-tertiary);">
        ecosystem · around iq lab
      </div>
      <h2 class="text-xl font-medium mb-2" style="letter-spacing: -0.015em; color: var(--color-text-primary);">
        Explore further
      </h2>
      <p class="text-sm mb-8" style="color: var(--color-text-secondary); line-height: 1.7; max-width: 40rem;">
        블로그를 넘어 연결된 공간들. 사람 · 두 연구소 · 각각의 지식 지도.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
        <!-- Personal profile -->
        <a
          href={SOCIAL.github}
          target="_blank"
          rel="noopener"
          class="eco-card p-4 rounded-md"
          style="background: var(--color-surface); border: 1px solid var(--color-border-subtle);"
        >
          <div class="flex items-center justify-between mb-1">
            <span class="font-mono text-[11px]" style="color: var(--color-text-tertiary);">
              person
            </span>
            <span class="font-mono text-[11px] eco-arrow" style="color: var(--color-text-tertiary);">
              ↗
            </span>
          </div>
          <div class="text-sm font-medium mb-1" style="color: var(--color-text-primary);">
            {SITE.author.handle}
          </div>
          <div class="font-mono text-[11px]" style="color: var(--color-text-tertiary);">
            github.com/{SITE.author.handle}
          </div>
          <div class="text-[11px] mt-2" style="color: var(--color-text-tertiary); line-height: 1.6;">
            저자의 개인 프로필. 연구소 밖의 작업들.
          </div>
        </a>

        <!-- IQ Dev Lab site -->
        <a
          href={SOCIAL.devLabSite}
          target="_blank"
          rel="noopener"
          class="eco-card p-4 rounded-md"
          style="background: var(--color-surface); border: 1px solid var(--color-border-subtle);"
        >
          <div class="flex items-center justify-between mb-1">
            <span class="font-mono text-[11px]" style="color: var(--color-accent-cyan);">
              iq-dev-lab
            </span>
            <span class="font-mono text-[11px] eco-arrow" style="color: var(--color-text-tertiary);">
              ↗
            </span>
          </div>
          <div class="text-sm font-medium mb-1" style="color: var(--color-text-primary);">
            Backend Knowledge Map
          </div>
          <div class="font-mono text-[11px]" style="color: var(--color-accent-cyan);">
            iq-dev-lab.github.io
          </div>
          <div class="text-[11px] mt-2" style="color: var(--color-text-tertiary); line-height: 1.6;">
            Java 백엔드 딥다이브 전체 지도를 시각적으로 탐색.
          </div>
        </a>

        <!-- IQ AI Lab site -->
        <a
          href={SOCIAL.aiLabSite}
          target="_blank"
          rel="noopener"
          class="eco-card p-4 rounded-md"
          style="background: var(--color-surface); border: 1px solid var(--color-border-subtle);"
        >
          <div class="flex items-center justify-between mb-1">
            <span class="font-mono text-[11px]" style="color: var(--color-accent-violet);">
              iq-ai-lab
            </span>
            <span class="font-mono text-[11px] eco-arrow" style="color: var(--color-text-tertiary);">
              ↗
            </span>
          </div>
          <div class="text-sm font-medium mb-1" style="color: var(--color-text-primary);">
            AI/ML Knowledge Map
          </div>
          <div class="font-mono text-[11px]" style="color: var(--color-accent-violet);">
            iq-ai-lab.github.io
          </div>
          <div class="text-[11px] mt-2" style="color: var(--color-text-tertiary); line-height: 1.6;">
            Layer 0~6, AI의 수학적 기반 탐구 지도.
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hide default <details> marker across browsers */
  details.group-card > summary::-webkit-details-marker {
    display: none;
  }
  details.group-card > summary::marker {
    content: '';
  }

  /* +/− toggle indicator */
  details.group-card[open] .toggle-icon {
    transform: rotate(45deg);
  }
  details.group-card .toggle-icon {
    display: inline-block;
    transition: transform 160ms ease;
  }

  /* Subtle hover affordance on the whole card */
  details.group-card > summary:hover h3 {
    opacity: 0.9;
  }

  /* Section-header site link — slightly more emphasis than github link */
  .site-link {
    font-weight: 500;
  }
  .site-link:hover {
    opacity: 0.8;
  }

  /* Ecosystem cards — subtle lift on hover */
  .eco-card {
    display: block;
    text-decoration: none;
    transition:
      border-color 160ms ease,
      transform 160ms ease;
  }
  .eco-card:hover {
    border-color: var(--color-text-tertiary) !important;
    transform: translateY(-1px);
  }
  .eco-card:hover .eco-arrow {
    color: var(--color-text-primary) !important;
  }
  .eco-arrow {
    transition: color 160ms ease;
  }
</style>
