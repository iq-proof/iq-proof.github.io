<script>
  // ════════════════════════════════════════════════════════
  // A1 — Typing animation for author intro
  // ════════════════════════════════════════════════════════
  function runTypingAnimation() {
    const lines = document.querySelectorAll<HTMLElement>('.terminal-line');
    if (lines.length === 0) return;

    // Respect reduced motion
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      lines.forEach(line => {
        const text = line.dataset.text || '';
        line.classList.add('typing');
        line.textContent = text;
      });
      return;
    }

    const TYPE_SPEED = 28;       // ms per character
    const LINE_PAUSE = 280;      // pause between lines
    const INITIAL_DELAY = 200;   // delay before starting

    function typeLine(line: HTMLElement, onComplete: () => void) {
      const text = line.dataset.text || '';
      line.classList.add('typing');

      // 빈 줄은 즉시 통과 (구분 간격용)
      if (text === '') {
        onComplete();
        return;
      }

      const cursor = document.createElement('span');
      cursor.className = 'terminal-cursor';
      line.appendChild(cursor);

      let i = 0;
      function tick() {
        if (i < text.length) {
          const char = document.createTextNode(text[i]);
          line.insertBefore(char, cursor);
          i++;
          setTimeout(tick, TYPE_SPEED);
        } else {
          cursor.remove();
          onComplete();
        }
      }
      tick();
    }

    function typeAll(index: number) {
      if (index >= lines.length) return;
      const currentLine = lines[index];
      typeLine(currentLine, () => {
        setTimeout(() => typeAll(index + 1), LINE_PAUSE);
      });
    }

    setTimeout(() => typeAll(0), INITIAL_DELAY);
  }

  // ════════════════════════════════════════════════════════
  // D10 — Closing quote fade-in on scroll
  // ════════════════════════════════════════════════════════
  function initClosingQuote() {
    const quote = document.querySelector<HTMLElement>('.closing-quote');
    if (!quote) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      quote.classList.add('visible');
      return;
    }

    const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              quote.classList.add('visible');
              observer.unobserve(quote);
            }
          });
        },
        { threshold: 0.3 }
    );
    observer.observe(quote);
  }

  // ════════════════════════════════════════════════════════
  // Initialize all
  // ════════════════════════════════════════════════════════
  function init() {
    runTypingAnimation();
    initClosingQuote();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
