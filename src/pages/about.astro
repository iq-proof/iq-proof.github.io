<style>
  /* ═══════════════════ Terminal typing (A1) ═══════════════════ */
  .terminal-container {
    min-height: 132px;
  }

  .terminal-line {
    position: relative;
    display: block;
    visibility: hidden;
  }

  .terminal-line.typing {
