---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CursorLight from '@/components/CursorLight.astro';
import SupernovaHero from '@/components/SupernovaHero.astro';
import PostCard from '@/components/PostCard.astro';
import { SITE, CATEGORIES } from '@/consts';
import { withBase } from '@/lib/url';
import { getPostsByCategory } from '@/utils/posts';

const devPosts = (await getPostsByCategory('dev')).slice(0, 5);
const aiPosts = (await getPostsByCategory('ai')).slice(0, 5);
const agentPosts = (await getPostsByCategory('agent')).slice(0, 5);

const devCount = (await getPostsByCategory('dev')).length;
const aiCount = (await getPostsByCategory('ai')).length;
const agentCount = (await getPostsByCategory('agent')).length;
---

<BaseLayout>
  <CursorLight mode="blend" />
  <!-- Hero — supernova backdrop (home only). Posts/categories stay static. -->
  <SupernovaHero devCount={devCount} aiCount={aiCount} agentCount={agentCount} />

  <!-- Dev section -->
  <section class="mx-auto px-6 py-8" style="max-width: var(--container-max);">
    <div class="flex items-end justify-between mb-4">
      <div>
        <div class="mono-label mb-1" style={`color: ${CATEGORIES.dev.accent};`}>
          {CATEGORIES.dev.description.toLowerCase()}
        </div>
        <h2 class="text-xl font-medium" style="letter-spacing: -0.015em; color: var(--color-text-primary);">
          Dev
        </h2>
      </div>
      <a
          href={withBase('/categories/dev')}
          class="font-mono text-xs transition-colors"
          style="color: var(--color-text-tertiary);"
      >
        view all →
      </a>
    </div>

    {
      devPosts.length === 0 ? (
          <div
              class="font-mono text-xs py-8 text-center rounded-md"
              style="background: var(--color-surface); color: var(--color-text-tertiary); border: 1px dashed var(--color-border-subtle);"
          >
            no posts yet — coming soon
          </div>
      ) : (
          <div>
            {devPosts.map((post) => (
                <PostCard post={post} />
            ))}
          </div>
      )
    }
  </section>

  <!-- AI section -->
  <section class="mx-auto px-6 py-8" style="max-width: var(--container-max);">
    <div class="flex items-end justify-between mb-4">
      <div>
        <div class="mono-label mb-1" style={`color: ${CATEGORIES.ai.accent};`}>
          {CATEGORIES.ai.description.toLowerCase()}
        </div>
        <h2 class="text-xl font-medium" style="letter-spacing: -0.015em; color: var(--color-text-primary);">
          AI
        </h2>
      </div>
      <a
          href={withBase('/categories/ai')}
          class="font-mono text-xs transition-colors"
          style="color: var(--color-text-tertiary);"
      >
        view all →
      </a>
    </div>

    {
      aiPosts.length === 0 ? (
          <div
              class="font-mono text-xs py-8 text-center rounded-md"
              style="background: var(--color-surface); color: var(--color-text-tertiary); border: 1px dashed var(--color-border-subtle);"
          >
            no posts yet — coming soon
          </div>
      ) : (
          <div>
            {aiPosts.map((post) => (
                <PostCard post={post} />
            ))}
          </div>
      )
    }
  </section>

  <!-- Agent section -->
  <section class="mx-auto px-6 py-8" style="max-width: var(--container-max);">
    <div class="flex items-end justify-between mb-4">
      <div>
        <div class="mono-label mb-1" style={`color: ${CATEGORIES.agent.accent};`}>
          {CATEGORIES.agent.description.toLowerCase()}
        </div>
        <h2 class="text-xl font-medium" style="letter-spacing: -0.015em; color: var(--color-text-primary);">
          Agent
        </h2>
      </div>
      <a
          href={withBase('/categories/agent')}
          class="font-mono text-xs transition-colors"
          style="color: var(--color-text-tertiary);"
      >
        view all →
      </a>
    </div>

    {
      agentPosts.length === 0 ? (
          <div
              class="font-mono text-xs py-8 text-center rounded-md"
              style="background: var(--color-surface); color: var(--color-text-tertiary); border: 1px dashed var(--color-border-subtle);"
          >
            no posts yet — coming soon
          </div>
      ) : (
          <div>
            {agentPosts.map((post) => (
                <PostCard post={post} />
            ))}
          </div>
      )
    }
  </section>
</BaseLayout>
