---
import CursorLight from '@/components/CursorLight.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getPublishedPosts } from '@/utils/posts';

const posts = await getPublishedPosts();
---

<BaseLayout title="Posts" description="All posts on IQ Lab.">
  <CursorLight mode="blend" />
  <section class="mx-auto px-6 pt-16 pb-12" style="max-width: var(--container-max);">
    <div class="mono-label mb-3" style="color: var(--color-accent-cyan);">
      all posts
    </div>
    <h1 class="text-3xl font-medium mb-3" style="letter-spacing: -0.025em; color: var(--color-text-primary);">
      Posts
    </h1>
    <p class="text-sm" style="color: var(--color-text-secondary);">
      총 {posts.length}개의 글 · 최신순
    </p>
  </section>

  <section class="mx-auto px-6 pb-16" style="max-width: var(--container-max);">
    {
      posts.length === 0 ? (
        <div
          class="font-mono text-xs py-12 text-center rounded-md"
          style="background: var(--color-surface); color: var(--color-text-tertiary); border: 1px dashed var(--color-border-subtle);"
        >
          no posts yet
        </div>
      ) : (
        <div>
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
